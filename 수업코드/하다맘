
library(skimr)
library(caret)
library(e1071)
library(pROC)
library(car)
library(broom)
library(dplyr)
library(rpart)
library(rpart.plot)

df <- read.csv("C:/Users/USER/Documents/pima-indians-diabetes.csv",
               header = TRUE, na = ".", stringsAsFactors = FALSE)

skim(df)

df$X1 <- ifelse(df$X1 == 1, "yes", "no")
df$X1 <- factor(df$X1, levels = c("no", "yes"))

trainIndex <- createDataPartition(df$X1, p = 0.8, list = FALSE)
train_data <- df[trainIndex, ]
test_data <- df[-trainIndex, ]

result1 <- glm(X1 ~ 1, data = train_data, family = "binomial")
result2 <- glm(X1 ~ ., data = train_data, family = "binomial")

anova(result1, result2, test = "Chisq")
summary(result2)

tidy_result <- tidy(result2) %>%mutate_if(is.numeric, round, 3)

print(tidy_result)

durbinWatsonTest(result2)
vif(result2)

cost_value <- 1
gamma_value <- 0.1

svm_model <- svm(  X1 ~ .,
                   data = train_data,
  type = "C-classification",
  kernel = "polynomial",
  cost = cost_value,
  gamma = gamma_value,
  probability = TRUE
)

summary(svm_model)

predicted_probs_svm <- predict(
  svm_model,
  newdata = test_data,
  probability = TRUE
)

predicted_probs_svm <- attr(
  predicted_probs_svm,
  "probabilities"
)[, "yes"]

predicted_classes_svm <- ifelse(
  predicted_probs_svm > 0.5,
  "yes",
  "no"
)

predicted_classes_svm <- factor(
  predicted_classes_svm,
  levels = levels(test_data$X1)
)

conf_matrix_svm <- confusionMatrix(
  predicted_classes_svm,
  test_data$X1,
  positive = "yes"
)

print(conf_matrix_svm)

roc_curve_svm <- roc(
  test_data$X1,
  predicted_probs_svm,
  levels = c("no", "yes"),
  direction = "<"
)

plot(roc_curve_svm, main = "SVM ROC Curve")
auc(roc_curve_svm)

