# 필요한 패키지 로드
library(skimr)
library(caret)
library(e1071)
library(pROC)
library(car)
library(broom)
library(dplyr)


df <- read.csv("C:/Users/USER/Documents/pima-indians-diabetes.csv", header = TRUE, na = ".")
skim(df)

df$X1 <- ifelse(df$X1 == 1, "yes", "no")
df$X1 <- as.factor(df$X1)


trainIndex <- createDataPartition(df$X1, p = 0.8, list = FALSE)
train_data <- df[trainIndex, ]
test_data  <- df[-trainIndex, ]

#로지스택택
result1 <- glm(X1 ~ 1, data = train_data, family = "binomial")
result2 <- glm(X1 ~ ., data = train_data, family = "binomial")

anova(result1, result2, test = "Chisq")
summary(result2)

# 회귀계수 정리 및 진단 (독립성, 다중공선성)
tidy_result <- tidy(result2) %>% mutate_if(is.numeric, round, 3)
print(tidy_result)
durbinWatsonTest(result2)
vif(result2)

cost_value  <- 1     # Cost(C)
gamma_value <- 0.1   # Gamma

svm_model <- svm(X1 ~ ., data = train_data, 
                 type = 'C-classification',  # Soft margin C-classification
                 kernel = 'polynomial',      # 다항커널 ('radial' 또는 'linear'로 변경 가능)
                 
                 cost = cost_value,
                 gamma = gamma_value,
                 probability = TRUE)         # 확률값으로 도출

summary(svm_model)

# SVM 예측 및 평가 (혼동행렬 & ROC/AUC)
predicted_probs <- predict(svm_model, newdata = test_data, probability = TRUE)
predicted_probs <- attr(predicted_probs, "probabilities")[, "yes"]

predicted_classes <- ifelse(predicted_probs > 0.5, "yes", "no")
predicted_classes <- factor(predicted_classes, levels = levels(test_data$X1))

conf_matrix_svm <- confusionMatrix(predicted_classes, test_data$X1, positive = "yes")
print(conf_matrix_svm)

roc_curve_svm <- roc(test_data$X1, predicted_probs)
plot(roc_curve_svm, main = "SVM ROC Curve")
auc(roc_curve_svm)

library(caret)
library(rpart) #CART모델
library(rpart.plot)
library(skimr)

df <- read.csv("C:/Users/USER/Documents/pima-indians-diabetes.csv")
skim(df)
df$X1 <- as.factor(df$X1)
train_indices <- createDataPartition(df$X1, p = 0.8, list = FALSE)
train_data <- df[train_indices, ]
test_data <- df[-train_indices, ]

#Hyper parameters 설정
control_params <- rpart.control(cp = 0.01, maxdepth = 5, minsplit = 10) 
#Complexity Parameter(분할될 때 마다 모델이 최소 1%는 개선이 되어야 함)
#maxdepth(트리의 깊이가 최대값), minsplit(각각의 노드에 최소 10개의 관측치가 있도록 분할)
#모델 생성
tree_model <- rpart(X1 ~ ., data = train_data, method = "class", control = control_params)
#모델 결과
summary(tree_model)
rpart.plot(tree_model)
predicted_probs <- predict(tree_model, test_data, type = "prob")[,1]
predicted_probs
predicted_classes <- ifelse(predicted_probs > 0.5, "A", "B")
predicted_classes <- as.factor(predicted_classes)
predicted_classes

library(pROC)
#Confusion Matrix 도출
confusion_matrix <- confusionMatrix(predicted_classes, test_data$X1)#---------------------------------------------------
print(confusion_matrix)
#ROC Curve
roc_curve <- roc(test_data$X1, predicted_probs)
plot(roc_curve)
auc(roc_curve)

