#아래부터 저번에 한거랑 이번에 한거랑 같이 다시 
library(caret)
library(e1071)
library(pROC)

# 1. 데이터 불러오기 및 전처리
df <- read.csv("heart.csv", header = TRUE, na = ".")
df$target <- ifelse(df$target == 1, "yes", "no")
df$target <- as.factor(df$target)

# 2. 데이터 분할 (8:2)
set.seed(123)
trainIndex <- createDataPartition(df$target, p = 0.8, list = FALSE)
train_data <- df[trainIndex, ]
test_data  <- df[-trainIndex, ]

# 3. 로지스틱 회귀 (예측, 혼동행렬, ROC/AUC)
logit_model <- glm(target ~ ., data = train_data, family = "binomial")
logit_probs <- predict(logit_model, newdata = test_data, type = "response")

logit_classes <- factor(ifelse(logit_probs > 0.5, "yes", "no"), levels = levels(test_data$target))
confusionMatrix(logit_classes, test_data$target, positive = "yes")

roc_logit <- roc(test_data$target, logit_probs)
plot(roc_logit)
auc(roc_logit)

# 4. SVM (예측, 혼동행렬, ROC/AUC)
svm_model <- svm(target ~ ., data = train_data,
                 type = 'C-classification',
                 kernel = 'polynomial',
                 cost = 1,
                 gamma = 0.1,
                 probability = TRUE)

svm_pred  <- predict(svm_model, newdata = test_data, probability = TRUE)
svm_probs <- attr(svm_pred, "probabilities")[, "yes"]

svm_classes <- factor(ifelse(svm_probs > 0.5, "yes", "no"), levels = levels(test_data$target))
confusionMatrix(svm_classes, test_data$target, positive = "yes")

roc_svm <- roc(test_data$target, svm_probs)
plot(roc_svm)
auc(roc_svm)

